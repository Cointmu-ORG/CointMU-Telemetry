# /etc/systemd/system/cointmu-infra-gpu.service (scopes/infra/README.md),
# started by cointmu-infra-gpu.timer.
# An own user: nvidia-smi and sysfs need no privileges.
[Unit]
Description=Write GPU metrics for the Alloy textfile collector

[Service]
Type=oneshot
ExecStart=/usr/local/lib/cointmu-infra/infra-metrics.py gpu
UMask=0027
User=cointmu-infra
Group=cointmu-infra
CapabilityBoundingSet=
PrivateNetwork=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cointmu-infra/gpu
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=128M
TimeoutStartSec=40s
