# /etc/systemd/system/cointmu-infra-smart.service (scopes/infra/README.md),
# started by cointmu-infra-smart.timer.
# Root, because disks answer SMART commands only to root: SYS_RAWIO (ATA, SAS)
# and SYS_ADMIN (NVMe) are all it keeps. No network.
[Unit]
Description=Write SMART metrics for the Alloy textfile collector

[Service]
Type=oneshot
ExecStart=/usr/local/lib/cointmu-infra/infra-metrics.py smart
UMask=0027
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN
PrivateNetwork=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cointmu-infra/smart
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=64M
TimeoutStartSec=5min
