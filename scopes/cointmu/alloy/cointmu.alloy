// Scope cointmu on a geth node server: reads the geth logs, labels them and
// redacts peer addresses and node IDs, and reads the chain metrics that
// scopes/cointmu/chain/ writes. Installed as /etc/alloy/conf.d/cointmu.alloy
// next to the push components (agent/push-logs.alloy, agent/push-metrics.alloy);
// Alloy loads the folder as one config. Settings come from /etc/default/alloy.
//
// Never rename a component here: its name is the key of its read positions on
// the host, and a renamed loki.source.file starts at the end of the log.

// --- Sources: a log file, the journal, or both. An empty variable turns its
// --- source off; both feed the same pipeline, so the labels are the same.

// GETH_LOG_FILES: one path or glob. Match the live files only, never the
// rotated copies (pm2-logrotate's "name__<date>.log", geth's "geth-<time>.log"),
// or rotated lines are pushed a second time.
local.file_match "geth" {
	path_targets = [{
		__path__ = sys.env("GETH_LOG_FILES"),
		job      = "geth",
	}]
}

loki.source.file "geth" {
	targets    = local.file_match.geth.targets
	forward_to = [loki.process.geth.receiver]
	// Lines are stamped when read, so skip what was logged before the first start.
	tail_from_end = true
}

// GETH_JOURNAL_UNIT: one systemd unit, e.g. geth.service.
loki.source.journal "geth" {
	matches       = "_SYSTEMD_UNIT=" + sys.env("GETH_JOURNAL_UNIT")
	labels        = {job = "geth"}
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.process.geth.receiver]
}

// role from the unit name: cointmu-miner.service -> miner, geth.service -> geth.
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = "(?:cointmu-)?(.+)\\.service"
		target_label  = "role"
	}
}

// --- Pipeline ---------------------------------------------------------------

loki.process "geth" {
	// role from the file name: cointmu-bootnode-error.log -> bootnode (PM2),
	// geth.log -> geth. Journal lines have no filename and keep their role.
	stage.regex {
		source     = "filename"
		expression = "(?:^|/)(?:cointmu-)?(?P<role>[A-Za-z0-9_]+?)(?:-error|-out)?\\.log$"
	}

	stage.labels {
		values = {role = ""}
	}

	// Geth glues the level to "[" (ERROR[10-20|...]); some builds write EROR.
	// "Fatal: ..." is printed on startup aborts. Other lines (stack traces)
	// get no level label.
	stage.regex {
		expression = "^(?P<level>TRACE|DEBUG|INFO|WARN|EROR|ERROR|CRIT|Fatal)\\b"
	}

	stage.template {
		source   = "level"
		template = "{{ if eq .Value \"EROR\" }}error{{ else }}{{ ToLower .Value }}{{ end }}"
	}

	// Debug output is the bulk of the volume and carries RPC client addresses.
	stage.drop {
		source     = "level"
		expression = "^(debug|trace)$"
	}

	stage.labels {
		values = {level = ""}
	}

	// Privacy: peers of a bootnode are students' laptops, so their addresses
	// and node keys (a stable per-install ID) never leave this machine. The raw
	// lines stay in the local log file for debugging over SSH.
	stage.replace {
		expression = "\\b((?:\\d{1,3}\\.){3}\\d{1,3})\\b"
		replace    = "<ip>"
	}

	// ponytail: IPv6 heuristic (full 8 groups or anything with "::"); it skips
	// clock times like 15:44:33. Swap for a stricter parser if it misfires.
	stage.replace {
		expression = "((?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|(?:[0-9a-fA-F]{1,4}:){0,6}[0-9a-fA-F]{0,4}::(?:[0-9a-fA-F]{1,4}:?){0,6})"
		replace    = "<ip>"
	}

	// Node IDs: enode://<id>@, id=<id>, peer=<id> (full or shortened), and ENR
	// records, which encode the IP address.
	stage.replace {
		expression = "(?:enode://|\\b(?:id|peer)=)([0-9a-fA-F]{8,}(?:\\.\\.[0-9a-fA-F]+)?)"
		replace    = "<node-id>"
	}

	stage.replace {
		expression = "(enr:-[A-Za-z0-9_-]+)"
		replace    = "<enr>"
	}

	// Here and not on the targets: the targets' labels are part of the key of
	// the read positions.
	stage.static_labels {
		values = {scope = "cointmu"}
	}

	forward_to = [loki.write.telemetry.receiver]
}

// --- Metrics: chain.prom from scopes/cointmu/chain/chain-metrics.py -----------------
// Install this file only after scopes/cointmu/chain/alloy-preflight.sh passes: without
// the metrics password or METRICS_PUSH_*, Alloy still runs and ships logs, but
// every metrics batch fails with a warning only.

// Only the textfile collector: none of the host's other metrics leave it.
prometheus.exporter.unix "chain" {
	set_collectors = ["textfile"]

	textfile {
		directory = coalesce(sys.env("CHAIN_TEXTFILE_DIR"), "/var/lib/cointmu-chain")
	}
}

// job="chain" for every series; host comes from remote_write, role from the file.
discovery.relabel "chain" {
	targets = prometheus.exporter.unix.chain.targets

	rule {
		target_label = "job"
		replacement  = "chain"
	}

	rule {
		target_label = "instance"
		replacement  = "chain"
	}

	rule {
		target_label = "scope"
		replacement  = "cointmu"
	}
}

prometheus.scrape "chain" {
	targets         = discovery.relabel.chain.output
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.telemetry.receiver]
}
