          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, ifName, ifAlias) (ifOperStatus{scope=\"network\",host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, ifName, ifAlias) (ifAdminStatus{scope=\"network\",host=~\"$host\"})",
