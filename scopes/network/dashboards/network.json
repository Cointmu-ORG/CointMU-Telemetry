{
  "uid": "network",
  "title": "Network",
  "tags": [
    "network",
    "prometheus"
  ],
  "editable": false,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Servers",
      "type": "dashboards",
      "tags": [
        "infra"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Switch",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(probe_success{scope=\"network\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(probe_success{scope=\"network\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Switches",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "description": "ok: answers ping or SSH and SNMP. no SNMP: reachable, but the last SNMP scrape failed. down: no answer.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "index": 0
                },
                "1": {
                  "text": "no SNMP",
                  "index": 1
                },
                "2": {
                  "text": "ok",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host) (probe_success{scope=\"network\",host=~\"$host\"}) + on (host) max by (host) (up{job=\"network-snmp\",host=~\"$host\"}) or max by (host) (probe_success{scope=\"network\",host=~\"$host\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Ports with link",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "description": "Ports whose operational status is up, per switch.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "namePlacement": "left",
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count by (host) (ifOperStatus{scope=\"network\",host=~\"$host\"} == 1)",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Errors per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "In + out errors on all chosen switches, 15 min average. Anything above 0 is worth a look: see Errors and discards below.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(ifInErrors{scope=\"network\",host=~\"$host\"}[15m]) + rate(ifOutErrors{scope=\"network\",host=~\"$host\"}[15m])) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Average traffic per active port",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "description": "Per switch: bits per second averaged over its ports that are up. In above the line, out below it.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "width": 240
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "avg by (host) (8 * rate(ifHCInOctets{scope=\"network\",host=~\"$host\"}[5m]) and on (host, ifName) ifOperStatus{scope=\"network\",host=~\"$host\"} == 1)",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "avg by (host) (8 * rate(ifHCOutOctets{scope=\"network\",host=~\"$host\"}[5m]) and on (host, ifName) ifOperStatus{scope=\"network\",host=~\"$host\"} == 1)",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} out"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
