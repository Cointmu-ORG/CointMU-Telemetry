{
  "uid": "network",
  "title": "Network",
  "tags": [
    "network",
    "prometheus"
  ],
  "editable": false,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Servers",
      "type": "dashboards",
      "tags": [
        "infra"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Switch",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(probe_success{scope=\"network\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(probe_success{scope=\"network\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Switches",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "description": "One row per switch from scripts/network.sh that answered in the last 24 h. Reachable: ping or SSH. SNMP: the last scrape. Errors: in + out per second, 15 min average.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reachable"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "index": 0
                      },
                      "1": {
                        "text": "ok",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SNMP"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAIL",
                        "index": 0
                      },
                      "1": {
                        "text": "ok",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Switch",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host) (last_over_time(probe_success{scope=\"network\"}[24h]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "P",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host) (probe_success{scope=\"network\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "S",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host) (up{job=\"network-snmp\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "U",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host) (sysUpTime{scope=\"network\"}) / 100",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "O",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count by (host) (ifOperStatus{scope=\"network\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host) (rate(ifInErrors{scope=\"network\"}[15m]) + rate(ifOutErrors{scope=\"network\"}[15m]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "host": "Switch",
              "Value #P": "Reachable",
              "Value #S": "SNMP",
              "Value #U": "Uptime",
              "Value #O": "Ports up",
              "Value #E": "Errors"
            },
            "indexByName": {
              "host": 0,
              "Value #P": 1,
              "Value #S": 2,
              "Value #U": 3,
              "Value #O": 4,
              "Value #E": 5
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Ports",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "description": "Every port of the chosen switches. Status: up, down, or lowerLayerDown (no link). Speed in Mbit/s as the port reports it.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "up",
                        "index": 0
                      },
                      "2": {
                        "text": "down",
                        "index": 1
                      },
                      "7": {
                        "text": "no link",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Enabled"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "yes",
                        "index": 0
                      },
                      "2": {
                        "text": "no",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Speed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "In"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Out"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Port",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, ifName, ifAlias) (ifOperStatus{scope=\"network\",host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, ifName, ifAlias) (ifAdminStatus{scope=\"network\",host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "S",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, ifName, ifAlias) (ifHighSpeed{scope=\"network\",host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "8 * max by (host, ifName, ifAlias) (rate(ifHCInOctets{scope=\"network\",host=~\"$host\"}[5m]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "O",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "8 * max by (host, ifName, ifAlias) (rate(ifHCOutOctets{scope=\"network\",host=~\"$host\"}[5m]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host, ifName, ifAlias) (rate(ifInErrors{scope=\"network\",host=~\"$host\"}[15m]) + rate(ifOutErrors{scope=\"network\",host=~\"$host\"}[15m]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Switch",
              "ifName": "Port",
              "ifAlias": "Description",
              "Value #A": "Status",
              "Value #D": "Enabled",
              "Value #S": "Speed",
              "Value #I": "In",
              "Value #O": "Out",
              "Value #E": "Errors"
            },
            "indexByName": {
              "host": 0,
              "ifName": 1,
              "ifAlias": 2,
              "Value #A": 3,
              "Value #D": 4,
              "Value #S": 5,
              "Value #I": 6,
              "Value #O": 7,
              "Value #E": 8
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Traffic in",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "Bits per second into the switch, per port with traffic.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "8 * rate(ifHCInOctets{scope=\"network\",host=~\"$host\"}[5m]) > 0",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} {{ifName}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Traffic out",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "Bits per second out of the switch, per port with traffic.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "8 * rate(ifHCOutOctets{scope=\"network\",host=~\"$host\"}[5m]) > 0",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} {{ifName}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors and discards",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "description": "Per second, per port that has any.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ifInErrors{scope=\"network\",host=~\"$host\"}[5m]) + rate(ifOutErrors{scope=\"network\",host=~\"$host\"}[5m]) > 0",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} {{ifName}} errors"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ifInDiscards{scope=\"network\",host=~\"$host\"}[5m]) + rate(ifOutDiscards{scope=\"network\",host=~\"$host\"}[5m]) > 0",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} {{ifName}} discards"
        }
      ]
    }
  ]
}
