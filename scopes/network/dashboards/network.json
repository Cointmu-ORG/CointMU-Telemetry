          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host, ifName, ifAlias) (rate(ifInErrors{scope=\"network\",host=~\"$host\"}[15m]) + rate(ifOutErrors{scope=\"network\",host=~\"$host\"}[15m]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Switch",
              "ifName": "Port",
              "ifAlias": "Description",
              "Value #A": "Status",
              "Value #D": "Enabled",
              "Value #S": "Speed",
              "Value #I": "In",
              "Value #O": "Out",
              "Value #E": "Errors"
            },
            "indexByName": {
              "host": 0,
              "ifName": 1,
              "ifAlias": 2,
              "Value #A": 3,
              "Value #D": 4,
              "Value #S": 5,
              "Value #I": 6,
              "Value #O": 7,
              "Value #E": 8
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "Status",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 1
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Status": true,
              "Enabled": true
            }
          }
        }
