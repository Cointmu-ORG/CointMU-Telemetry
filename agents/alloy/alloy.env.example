# Copy to /etc/default/alloy on the geth node (root:root, 0644; no secrets
# here, the passwords live in /etc/alloy/push-password and
# /etc/alloy/metrics-password). agents/alloy/README.md and agents/chain/README.md
# have the install steps.

# --- Read by the Debian package's systemd unit --------------------------------
CONFIG_FILE="/etc/alloy/config.alloy"
# experimental: the loki.write WAL (disk buffer). The UI stays on localhost;
# no usage reports to Grafana Labs.
CUSTOM_ARGS="--stability.level=experimental --server.http.listen-addr=127.0.0.1:12345 --disable-reporting"
# Upgrades are manual (apt-mark hold alloy, RUNBOOK.md); do not restart on them.
RESTART_ON_UPGRADE=false

# --- Read by config.alloy -------------------------------------------------------
# The "host" label; short and stable, e.g. bootnode-a.
AGENT_HOST=
# Push endpoint on the telemetry VM, matching the certificate's subjectAltName.
LOKI_PUSH_URL=https://<TELEMETRY_IP>/loki/api/v1/push
# The login made with scripts/agent-cred.sh add <name> on the VM.
LOKI_PUSH_USER=
# Chain metrics (agents/chain/): push endpoint and the metrics login
# (scripts/agent-cred.sh add <name> metrics); its password goes in
# /etc/alloy/metrics-password. Run agents/chain/alloy-preflight.sh before
# installing config.alloy.
METRICS_PUSH_URL=https://<TELEMETRY_IP>/prometheus/api/v1/write
METRICS_PUSH_USER=

# Sources: set one or both; leave a source empty to turn it off.
# Log file(s) of the geth process(es). Match the live files only, never rotated
# copies. PM2 (stderr goes to <name>-error.log, rotated by pm2-logrotate):
GETH_LOG_FILES=/home/<USER>/.pm2/logs/cointmu-*-error.log
# geth started with --log.file:  GETH_LOG_FILES=/var/log/geth/geth.log
# systemd unit whose journal holds geth's output (one unit), e.g. geth.service:
GETH_JOURNAL_UNIT=
