# Copy to /etc/default/alloy on the UPS host (root:root, 0644; no secrets
# here, the passwords live in /etc/alloy/push-password and
# /etc/alloy/metrics-password). agents/ups/README.md has the install steps.

# --- Read by the Debian package's systemd unit --------------------------------
CONFIG_FILE="/etc/alloy/config.alloy"
# experimental: the loki.write WAL (disk buffer). The UI stays on localhost;
# no usage reports to Grafana Labs.
CUSTOM_ARGS="--stability.level=experimental --server.http.listen-addr=127.0.0.1:12345 --disable-reporting"
# Upgrades are manual (apt-mark hold alloy, RUNBOOK.md); do not restart on them.
RESTART_ON_UPGRADE=false

# --- Read by config.alloy -------------------------------------------------------
# The "host" label; short and stable, e.g. pve-ups.
AGENT_HOST=
# The UPS as upsc names it, without @host (upsc -l): the "ups" label of the
# logs and the driver unit's name; the metrics take it from cointmu-ups.conf.
# Must be the same name.
UPS_NAME=ups
# Push endpoints on the telemetry VM, matching the certificate's subjectAltName.
LOKI_PUSH_URL=https://<TELEMETRY_IP>/loki/api/v1/push
METRICS_PUSH_URL=https://<TELEMETRY_IP>/prometheus/api/v1/write
# The two logins made on the VM with scripts/agent-cred.sh add <name> [metrics].
LOKI_PUSH_USER=
METRICS_PUSH_USER=

# NUT's systemd units (systemctl list-units 'nut*'). Empty NUT_DRIVER_UNIT =
# nut-driver@<UPS_NAME>.service, the Debian NUT 2.8 name.
NUT_DRIVER_UNIT=
NUT_SERVER_UNIT=nut-server.service
NUT_MONITOR_UNIT=nut-monitor.service
