# Copy to /etc/cointmu-ups/cointmu-ups.conf on the UPS host (root:root 0644,
# no secrets here). Read by ups-notify.sh and ups-metrics.sh.

# The UPS as upsc names it: upsc -l lists the names, add @localhost.
UPS=ups@localhost
# Short name of this host in Discord messages; empty = hostname -s.
HOST_LABEL=
