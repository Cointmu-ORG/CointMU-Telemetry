# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- Network -----------------------------------------------------------------
# The VM's campus LAN address (10.0.0.10 is a placeholder). The HTTPS port is
# published only on this IP. If you change HTTPS_PORT, update the firewall rule.
BIND_IP=10.0.0.10
HTTPS_PORT=443
# How the app and browsers reach the server; must match the certificate SAN.
GLITCHTIP_HOST=10.0.0.10

# --- TLS key access ----------------------------------------------------------
# GID of the dedicated host group that owns certs/server.key (README.md, step 2).
# Never 101: inside the proxy that is nginx, on the host a system group (syslog).
TLS_GID=

# --- Secrets (generate, do not reuse) -------------------------------------------
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Data retention (days) ------------------------------------------------------
# Events older than this are deleted. Issue #57 asks for 30-90 days.
GLITCHTIP_RETENTION_DAYS=60

# --- Node logs (Loki) -------------------------------------------------------------
# Geth node logs older than this are deleted by Loki's compactor (720h = 30 days).
LOKI_RETENTION_PERIOD=720h
# Host metrics (Prometheus, e.g. the UPS host): deleted after this time or once
# the data exceeds this size, whichever comes first.
PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=2GB
# Grafana "admin" password, used only when Grafana first starts (RUNBOOK.md
# rotates it later). openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# --- Alerts (Discord) ----------------------------------------------------------------
# One webhook per channel (README.md, Alerts): Discord → Edit Channel →
# Integrations → Webhooks → Copy Webhook URL. SECRETS: anyone with a URL can
# post to that channel. Empty = that alert source is off, nothing else fails.
# GlitchTip new issues of the desktop app → #app-errors. Applied by
# scripts/init-project.sh (re-run it after a change).
DISCORD_WEBHOOK_APP_ERRORS=
# Grafana alert rules on the geth node logs → #node-logs. Applied by
# docker compose up -d grafana.
DISCORD_WEBHOOK_NODE_LOGS=
# scripts/healthcheck.sh (cron) → #infra. Read on every run.
DISCORD_WEBHOOK_INFRA=

# --- Backups (age encryption)-----------------------------------------------------
# age public key (age1...) that backup.sh and backup-config.sh encrypt the
# off-VM copies to. Not a secret; the matching private key is kept offline and
# never on this VM (README.md, Backups). Empty: backup.sh keeps plaintext dumps
# on this VM only and warns that the off-VM copy is disabled.
BACKUP_AGE_RECIPIENT=
