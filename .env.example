# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- Network -----------------------------------------------------------------
# The VM's campus LAN address (10.0.0.10 is a placeholder). The HTTPS port is
# published only on this IP. If you change HTTPS_PORT, update the firewall rule.
BIND_IP=10.0.0.10
HTTPS_PORT=443
# How the app and browsers reach the server; must match the certificate SAN.
GLITCHTIP_HOST=10.0.0.10

# --- TLS key access ----------------------------------------------------------
# GID of the dedicated host group that owns certs/server.key (README.md, step 2).
# Never 101: inside the proxy that is nginx, on the host a system group (syslog).
TLS_GID=

# --- Secrets (generate, do not reuse) -------------------------------------------
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Data retention (days) ------------------------------------------------------
# Events older than this are deleted. Issue #57 asks for 30-90 days.
GLITCHTIP_RETENTION_DAYS=60

# --- Node logs (Loki) -------------------------------------------------------------
# Geth node logs older than this are deleted by Loki's compactor (720h = 30 days).
LOKI_RETENTION_PERIOD=720h
