# Secrets and per-host state never go in git.
.env
certs/
backup/
# Per-host stamps (healthcheck state, off-VM backup stamp).
state/
*.key
*.sql.gz
# Per-host nginx files (allowlists, agent logins); only the examples are tracked.
nginx/local/*
!nginx/local/*.example
# Location of the admin allowlist before nginx/local/ existed.
nginx/admin-allow.conf
