# Fill in the placeholders, then append to /etc/ufw/after.rules and run
# sudo ufw reload && sudo systemctl restart docker (README.md has the command):
#   <BIND_IP>           BIND_IP from .env (the address the proxy is published on)
#   <CAMPUS_SUBNET>     the campus LAN, e.g. 10.0.0.0/16
#   <TAILSCALE_SUBNET>  allowed tailnet IPs, comma-separated, e.g. 100.101.102.103/32
#                       (delete that line when nobody comes in over Tailscale)
#   <HTTPS_PORT>        HTTPS_PORT from .env (the host port, not the container's 8443)
# If BIND_IP or HTTPS_PORT changes later, change it here and in /etc/ufw/after.rules
# too, or the new address or port is open to everyone and the old rule guards nothing.
#
# Docker publishes ports through its own NAT rules, which bypass ufw's INPUT
# chain. DOCKER-USER is evaluated first for container traffic, so the LAN-only
# rule for the published HTTPS port has to live here. Matching on the original
# destination address and port keeps it correct after Docker's DNAT to the
# container port, and limits it to connections to the proxy: the containers' own
# outgoing HTTPS (the Discord alerts) passes DOCKER-USER too and must not match.

# BEGIN cointmu-telemetry
*filter
:DOCKER-USER - [0:0]
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdst <BIND_IP> --ctorigdstport <HTTPS_PORT> --ctdir ORIGINAL -s <CAMPUS_SUBNET> -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdst <BIND_IP> --ctorigdstport <HTTPS_PORT> --ctdir ORIGINAL -s <TAILSCALE_SUBNET> -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdst <BIND_IP> --ctorigdstport <HTTPS_PORT> --ctdir ORIGINAL -j DROP
COMMIT
# END cointmu-telemetry
